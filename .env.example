# LLM API Configuration
# Works with any OpenAI-compatible API (LM Studio, Ollama, OpenAI, etc.)

# API base URL
# LM Studio:  http://127.0.0.1:1234/v1
# Ollama:     http://127.0.0.1:11434/v1
# OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1

# API key (not needed for local servers like LM Studio / Ollama)
LLM_API_KEY=

# Model to use (must match the model loaded in your LLM server)
LLM_MODEL=google/gemma-4-26b-a4b-qat

# Server port (default: 3000)
PORT=3000
