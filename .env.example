# LLM API Configuration
# Works with any OpenAI-compatible API (LM Studio, Ollama, OpenRouter, OpenAI, vLLM, etc.)

# API base URL
# LM Studio:   http://127.0.0.1:1234/v1
# Ollama:      http://127.0.0.1:11434/v1
# OpenRouter:  https://openrouter.ai/api/v1
# OpenAI:      https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1

# API key (not needed for local servers like LM Studio / Ollama)
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Model to use. For OpenRouter this is a router id, e.g.
# anthropic/claude-sonnet-4, openai/gpt-4o, meta-llama/llama-3.3-70b-instruct:free
# Run "npm start" and GET /v1/models to list what your backend offers.
LLM_MODEL=qwen/qwen3.5-9b

# ── Reliability ─────────────────────────────────────────────────────────────
# How long to wait for the LLM before giving up (milliseconds)
LLM_TIMEOUT_MS=120000
# How many times to retry a failed LLM call
LLM_MAX_RETRIES=2
# Cap on the answer length. 0 sizes it from the number of questions instead.
LLM_MAX_TOKENS=0

# ── OpenRouter (ignored by other backends) ─────────────────────────────────
# App attribution. OpenRouter uses these for free-tier limits and rankings.
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=xev
# Preferred upstream providers, in order, e.g. groq,together,fireworks
LLM_PROVIDER_ORDER=
# Set to deny to only use providers that do not train on your prompts
LLM_DATA_COLLECTION=
# Serve the backend's catalog at /v1/models (auto-enabled for OpenRouter)
LLM_DISCOVER_MODELS=

# ── Reasoning models ─────────────────────────────────────────────────────────
# Reasoning models think before answering, and those tokens come out of the
# same max_tokens budget. xev adds room for them and can switch them off.
#
# OpenRouter puts reasoning in a `reasoning` object. Every other
# OpenAI-compatible server speaks the standard top-level `reasoning_effort`,
# which LM Studio and SGLang implement directly and which vLLM translates into
# the chat template's `enable_thinking`. `none` is translated for those backends,
# so it means the same thing everywhere; the other levels stay OpenRouter-only,
# because LM Studio answers them with a 400.
#   LLM_REASONING_EXCLUDE=false   return the trace (for debugging, OpenRouter)
#   LLM_REASONING_EFFORT=none     no thinking at all - fastest, where supported
#   LLM_REASONING_EFFORT=low      a little thinking - OpenRouter
#   LLM_REASONING_MAX_TOKENS=2048 hard cap on thinking, in tokens (OpenRouter)
# Values: max, xhigh, high, medium, low, minimal, none
LLM_REASONING_EXCLUDE=true
LLM_REASONING_EFFORT=
LLM_REASONING_MAX_TOKENS=
# Extra parameters merged into the LLM request body, for anything xev does not
# set for you. Merged last, so a key here overrides what xev derived, and sent
# only when set - a server that rejects an unknown body key answers 400.
#   LLM_EXTRA_BODY={"reasoning_effort":"high"}
#   LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#   LLM_EXTRA_BODY={"thinking_token_budget":1024}
LLM_EXTRA_BODY=

# ── Server ──────────────────────────────────────────────────────────────────
# Server port (default: 3000)
PORT=3000
# Interface to bind. Leave unset to accept connections on all interfaces; the
# startup banner shows localhost unless you set a specific address here.
# HOST=127.0.0.1
# Comma-separated origins allowed to call the API from a browser, or *.
# Leave empty to send no CORS headers.
CORS_ORIGIN=
# Requests per minute per client for /v1/systemone. 0 disables the limit.
RATE_LIMIT_RPM=0
